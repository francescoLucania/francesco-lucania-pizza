{
  "compileOnSave": false,
  "compilerOptions": {
    "useDefineForClassFields": false,
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@francesco-lucania-pizza-models": ["models/index.ts"],
      "@francesco-lucania-pizza/angular-ui": [
        "libs/francesco-lucania-pizza-ui/src/angular/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
