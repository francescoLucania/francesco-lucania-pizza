{
  "name": "pizza-store",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/pizza-store",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project pizza-store --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/apps/pizza-store/.next/!(cache)/**/*",
        "{workspaceRoot}/apps/pizza-store/.next/!(cache)"
      ],
      "options": {
        "command": "next build && rm -rf .next/standalone/apps/pizza-store/.next/static && cp -R .next/static .next/standalone/apps/pizza-store/.next/static && rm -rf .next/standalone/apps/pizza-store/public && cp -R public .next/standalone/apps/pizza-store/public",
        "cwd": "apps/pizza-store"
      },
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["next"]
        }
      ]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next dev",
        "cwd": "apps/pizza-store"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next start",
        "cwd": "apps/pizza-store"
      },
      "dependsOn": ["build"]
    },
    "serve-static": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next start",
        "cwd": "apps/pizza-store"
      },
      "dependsOn": ["build"]
    }
  }
}
